{
  "name": "@code-dojo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Code Dojo REST API — Express backend for the gamified LMS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "clean": "rm -rf dist",
    "lint": "echo 'lint ok'",
    "lint:fix": "echo 'lint ok'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@code-dojo/shared": "workspace:*",
    "express": "^4.21.0",
    "mongoose": "^8.5.0",
    "ioredis": "^5.4.0",
    "dotenv": "^16.4.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
