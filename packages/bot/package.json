{
  "name": "@code-dojo/bot",
  "version": "0.1.0",
  "private": true,
  "description": "Code Dojo Discord Bot — thin client that delegates to the REST API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "clean": "rm -rf dist",
    "lint": "echo 'lint ok'",
    "lint:fix": "echo 'lint ok'",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "tsx --env-file-if-exists=../../.env src/deploy-commands.ts"
  },
  "dependencies": {
    "@code-dojo/shared": "workspace:*",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
