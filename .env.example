# ===========================================
# Code Dojo — Environment Variables
# Copy to .env and fill in the values
# ===========================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/code-dojo

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Discord Bot ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --- Discord Roles ---
TEACHER_ROLE_ID=

# --- API Server ---
API_PORT=3000
API_HOST=0.0.0.0
API_URL=http://localhost:3000

# --- API Auth ---
# Must be at least 16 characters; use a strong random value in production
API_KEY=

# --- JWT (future: web dashboard auth) ---
JWT_SECRET=change-me-in-production-use-random-string
JWT_EXPIRES_IN=7d

# --- Logging ---
LOG_LEVEL=debug

# --- Node Environment ---
NODE_ENV=development
